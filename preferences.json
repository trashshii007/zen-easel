[
  {
    "type": "text",
    "label": "Zen Easel",
    "size": "20px",
    "margin": "18px 0 2px 0"
  },
  {
    "type": "text",
    "label": "An infinite canvas for web captures, text, shapes and ink — stored locally in your profile, never uploaded.",
    "size": "12px",
    "margin": "0 0 6px 0"
  },

  {
    "type": "separator",
    "label": "Canvas",
    "margin": "20px 0 10px 0"
  },
  {
    "type": "checkbox",
    "property": "zen.easel.hide-topbar",
    "label": "Hide the top bar — the easel switcher moves to the canvas right-click menu.",
    "defaultValue": false
  },
  {
    "type": "dropdown",
    "property": "zen.easel.wheel",
    "label": "Scroll wheel. Ctrl+wheel always zooms.",
    "defaultValue": "zoom",
    "options": [
      { "value": "zoom", "label": "Zoom (centred on the pointer)" },
      { "value": "pan", "label": "Scroll the canvas" }
    ]
  },
  {
    "type": "dropdown",
    "property": "zen.easel.ink-style",
    "label": "Pen stroke style.",
    "defaultValue": "variable",
    "options": [
      { "value": "variable", "label": "Variable width (speed and stylus pressure)" },
      { "value": "uniform", "label": "Uniform width" }
    ]
  },
  {
    "type": "dropdown",
    "property": "zen.easel.grid",
    "label": "Canvas grid. Board colour is per easel — right-click empty canvas.",
    "defaultValue": "dots",
    "placeholder": "dots",
    "options": [
      { "value": "none", "label": "Plain" },
      { "value": "dots", "label": "Dots" },
      { "value": "lines", "label": "Grid lines" }
    ]
  },
  {
    "type": "dropdown",
    "property": "zen.easel.snap",
    "label": "How objects snap while you move them. Hold Alt to suppress.",
    "defaultValue": "guides",
    "options": [
      { "value": "guides", "label": "Alignment guides (to other objects)" },
      { "value": "grid", "label": "Grid (to fixed intervals)" },
      { "value": "none", "label": "No snapping" }
    ]
  },
  {
    "type": "string",
    "value": "number",
    "property": "zen.easel.grid-size",
    "label": "Grid size in canvas pixels.",
    "defaultValue": 24,
    "placeholder": "24"
  },

  {
    "type": "separator",
    "label": "Capture backdrop",
    "margin": "20px 0 10px 0"
  },
  {
    "type": "dropdown",
    "property": "zen.easel.capture-backdrop",
    "label": "What goes behind a captured page, so a transparent tab is not flattened onto white.",
    "defaultValue": "auto",
    "options": [
      { "value": "auto", "label": "Your window's colour, on transparent tabs" },
      { "value": "always", "label": "Your window's colour, always" },
      { "value": "page", "label": "Plain white or near-black, by your light/dark setting" },
      { "value": "custom", "label": "A colour of your own (below)" },
      { "value": "off", "label": "Off — Firefox's white" }
    ]
  },
  {
    "type": "string",
    "property": "zen.easel.capture-backdrop-color",
    "label": "The colour used by Custom above. Any CSS colour.",
    "defaultValue": "",
    "placeholder": "#1b1b1b"
  },

  {
    "type": "separator",
    "label": "Live web cards",
    "margin": "20px 0 10px 0"
  },
  {
    "type": "checkbox",
    "property": "zen.easel.live.enabled",
    "label": "Allow a captured card to be flipped to the real, live website.",
    "defaultValue": true
  },
  {
    "type": "string",
    "value": "number",
    "property": "zen.easel.live.max-tiles",
    "label": "How many cards may be live at once, per window. 0 means no limit.",
    "defaultValue": 12,
    "placeholder": "12"
  },
  {
    "type": "string",
    "value": "number",
    "property": "zen.easel.live.idle-timeout-min",
    "label": "Stop a live card after this many minutes out of sight. 0 means never.",
    "defaultValue": 30,
    "placeholder": "30"
  },
  {
    "type": "string",
    "value": "number",
    "property": "zen.easel.live.reveal-delay-ms",
    "label": "Delay before revealing live cards after switching back to an easel.",
    "defaultValue": 140,
    "placeholder": "140"
  },
  {
    "type": "checkbox",
    "property": "zen.easel.live.private",
    "label": "Load live cards in a private session — sites render logged out.",
    "defaultValue": false
  },
  {
    "type": "string",
    "value": "number",
    "property": "zen.easel.live.container",
    "label": "Container ID for live cards, or 0 for your normal session.",
    "defaultValue": 0,
    "placeholder": "0"
  },
  {
    "type": "checkbox",
    "property": "zen.easel.live.allow-http",
    "label": "Allow live cards over plain http.",
    "defaultValue": false
  },

  {
    "type": "separator",
    "label": "Storage",
    "margin": "20px 0 10px 0"
  },
  {
    "type": "string",
    "value": "number",
    "property": "zen.easel.autosave-ms",
    "label": "Autosave delay in milliseconds after the last change.",
    "defaultValue": 500,
    "placeholder": "500"
  },
  {
    "type": "string",
    "property": "zen.easel.storage-dir",
    "label": "Where easels are stored. Empty uses zen-easels in your profile folder.",
    "defaultValue": "",
    "placeholder": "(profile)/zen-easels"
  },

  {
    "type": "separator",
    "label": "Split view",
    "margin": "20px 0 10px 0"
  },
  {
    "type": "dropdown",
    "property": "zen.easel.split-resize",
    "label": "Works around a split divider snapping and strobing with an about: page in the split.",
    "defaultValue": "ghost",
    "options": [
      { "value": "ghost", "label": "Move a guide line, resize on release (fixes both)" },
      { "value": "freeze", "label": "Resize live, hold the page still (no strobe)" },
      { "value": "off", "label": "Off — Zen's own behaviour" }
    ]
  },

  {
    "type": "separator",
    "label": "Development",
    "margin": "20px 0 10px 0"
  },
  {
    "type": "checkbox",
    "property": "zen.easel.debug",
    "label": "Log [zen-easel] diagnostics to the Browser Console.",
    "defaultValue": false
  }
]
